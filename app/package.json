{
  "name": "@pointmatic/quizazz",
  "version": "1.3.0",
  "description": "Embeddable SvelteKit quiz component for Quizazz assessments.",
  "license": "Apache-2.0",
  "author": "Pointmatic",
  "homepage": "https://github.com/pointmatic/quizazz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pointmatic/quizazz.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/pointmatic/quizazz/issues"
  },
  "keywords": [
    "quiz",
    "assessment",
    "education",
    "svelte",
    "sveltekit",
    "quizazz"
  ],
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/embed/index.d.ts",
      "svelte": "./dist/embed/index.js",
      "default": "./dist/embed/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "svelte": "./dist/embed/index.js",
  "types": "./dist/embed/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "dependencies": {
    "lucide-svelte": "^0.563.0",
    "sql.js": "^1.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "package": "svelte-package -i src/lib -o dist && node scripts/build-styles.mjs && node scripts/clean-dist.mjs",
    "publint": "publint",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/svelte": "^5.3.1",
    "@types/sql.js": "^1.4.9",
    "eslint": "^10.0.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "publint": "^0.3.18",
    "svelte": "^5.50.1",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
